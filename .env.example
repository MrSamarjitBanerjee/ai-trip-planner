# AI Trip Planner environment variables
# copy this file to .env and fill in real values
#   PowerShell: Copy-Item .env.example .env
# never commit your actual .env

GROQ_API_KEY=

# any postgres url works; local example below
# postgresql://postgres:postgres@localhost:5432/trip_planner
DATABASE_URL=

TAVILY_API_KEY=
AVIATION_STACK_API_KEY=
OPENWEATHER_API_KEY=

# optional
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=2500
DEFAULT_ORIGIN_IATA=

# optional langsmith tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-trip-planner
